{
  "name": "xl300-ctd-manager",
  "image": "ghcr.io/umeshwalkar/xl300-dev-base:0.1.0",
  "runArgs": [
    // DDS multicast discovery needs host networking to behave like a real node.
    "--network=host",
    "--name", "xl300-ctd-manager-dev"
  ],
  // uuv_common/uuv_interfaces submodule URLs are POSIX paths (/workspace-dds/...),
  // not real host paths -- git-on-Linux parses "D:/..." as an SSH host string and
  // fails ("cannot run ssh") on any fresh clone/init. This mount makes
  // /workspace-dds/... resolve to the actual sibling repos. Uses
  // ${localWorkspaceFolder}/.. (this repo's parent dir = workspace-dds) rather
  // than a hardcoded absolute path, so it resolves correctly regardless of
  // drive letter/username/clone location on whatever machine opens this.
  // INTERIM fix: once xl300-dds-v2/uuv_common/uuv_interfaces are pushed to
  // GitHub, switch every .gitmodules entry to the real https:// URL and remove
  // this mount -- see each repo's README.md "Provenance" section.
  // "uuv-ccache" is a NAMED volume (not a bind mount), shared across every XL300
  // manager's devcontainer that uses the same volume name -- one warm cache
  // instead of a cold one per repo/rebuild. CCACHE_DIR pins the location
  // explicitly rather than relying on ccache's version-dependent default
  // (~/.cache/ccache on modern ccache, ~/.ccache on older).
  "mounts": [
    "source=${localWorkspaceFolder}/..,target=/workspace-dds,type=bind",
    "source=uuv-ccache,target=/root/.cache/ccache,type=volume"
  ],
  // protocol.file.allow: modern git blocks local 'file' transport for NESTED
  // submodule clones by default (hardening against a malicious repo using a
  // local-path submodule to read arbitrary host files) -- our own submodules are
  // trusted local paths, not a third party's, so this is safe here. Without it,
  // `git submodule update --init --recursive` fails with "transport 'file' not
  // allowed" on a genuinely fresh clone, confirmed 2026-08-27.
  "onCreateCommand": "git config --global protocol.file.allow always && git submodule update --init --recursive",
  "postCreateCommand": "echo 'ctd-manager devcontainer ready: cmake -B build && cmake --build build'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "anthropic.claude-code"
      ],
      "settings": {
        "cmake.configureOnOpen": true
      }
    }
  },
  "remoteEnv": {
    "FASTRTPS_DEFAULT_PROFILES_FILE": "${containerWorkspaceFolder}/deps/uuv_interfaces/xl300-dds-v2/qos/xl300_profiles.xml",
    "CCACHE_DIR": "/root/.cache/ccache"
  }
}
